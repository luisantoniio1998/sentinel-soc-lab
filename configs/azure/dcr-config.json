{
  "description": "Data Collection Rule for Security Lab syslog ingestion into Azure Sentinel",
  "dataSources": {
    "syslog": [
      {
        "name": "syslog-webapp",
        "streams": ["Microsoft-Syslog"],
        "facilityNames": ["auth", "local0", "local1"],
        "logLevels": ["Debug", "Info", "Notice", "Warning", "Error", "Critical", "Alert", "Emergency"],
        "comment": "Replace facility names to match your rsyslog output"
      }
    ]
  },
  "destinations": {
    "logAnalytics": [
      {
        "workspaceResourceId": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RG/providers/Microsoft.OperationalInsights/workspaces/YOUR_WORKSPACE",
        "name": "sentinel-workspace"
      }
    ]
  },
  "dataFlows": [
    {
      "streams": ["Microsoft-Syslog"],
      "destinations": ["sentinel-workspace"]
    }
  ]
}
